# Copy this file to .env and fill in real values before running
# `docker compose up` or the backend/frontend locally.
# Never commit the real .env file.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=triallens
POSTGRES_PASSWORD=triallens
POSTGRES_DB=triallens
POSTGRES_PORT=5432

# Used by the backend (SQLAlchemy/Alembic). Inside docker-compose the host
# is the service name "db"; if you run the backend outside Docker against
# the compose Postgres, change the host to "localhost".
DATABASE_URL=postgresql+psycopg://triallens:triallens@db:5432/triallens

# --- Backend (FastAPI) ------------------------------------------------------
APP_ENV=development
# Currently not wired to anything (see app/core/config.py's Settings.debug
# docstring) - kept false here so the shipped default is never accidentally
# insecure-looking, even though today this flag has no runtime effect.
DEBUG=false
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Anthropic Claude (not used until Phase 4, but wired into config now) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ingestion sources (Phase 2) --------------------------------------------
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# Optional, recommended by NCBI for a higher E-utilities rate limit:
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# --- Retrieval / embeddings (Phase 3) ---------------------------------------
# "hashing" (default: deterministic, no network/API key needed) or "voyage".
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSION=256
# Only needed when EMBEDDING_PROVIDER=voyage:
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# --- Frontend (Next.js) -----------------------------------------------------
FRONTEND_PORT=3000
# Base URL the browser uses to reach the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8000
